# ─── Security ──────────────────────────────────────────────────────────
# Must be a securely generated 32+ character random string
# Generate using: openssl rand -base64 32
JWT_SECRET=your_secure_random_base64_string_here

# ─── Database (Supabase) ─────────────────────────────────────────────
# IMPORTANT: Use the Connection Pooler URL (port 6543) if deploying on platforms like Railway
DATABASE_URL=jdbc:postgresql://aws-0-XX-XXXX-X.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_supabase_password

# ─── CORS ────────────────────────────────────────────────────────────
# The frontend URL that is allowed to connect to this API
ALLOWED_ORIGINS=https://your-frontend.vercel.app
